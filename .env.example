# Canonical origin of the site, without trailing slash.
# Used for canonical URLs, Open Graph tags, sitemap.xml, robots.txt and JSON-LD.
# On Vercel set it for the Production environment; locally it falls back to
# http://localhost:3000.
NEXT_PUBLIC_SITE_URL=https://kkratter.com

# PostHog project API key (phc_...), public by design. Set it on Vercel for the
# Production environment only; when it is missing, analytics are off.
# NEXT_PUBLIC_POSTHOG_KEY=phc_xxx
# PostHog region, EU by default. For a US project use https://us.i.posthog.com
# and https://us.posthog.com.
# NEXT_PUBLIC_POSTHOG_HOST=https://eu.i.posthog.com
# NEXT_PUBLIC_POSTHOG_UI_HOST=https://eu.posthog.com
